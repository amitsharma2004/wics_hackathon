# Production Environment Variables

# Server
NODE_ENV=production
PORT=3000

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/rideshare?retryWrites=true&w=majority

# Redis
REDIS_URL=redis://your-redis-host:6379

# JWT Secrets (Generate strong secrets!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://yourdomain.com/api/users/auth/google/callback

# Email Configuration (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=RideShare <noreply@yourdomain.com>

# Frontend URL (for CORS)
FRONTEND_URL=https://yourdomain.com

# Allowed Email Domains (optional, comma-separated)
# ALLOWED_EMAIL_DOMAINS=gmail.com,yahoo.com
